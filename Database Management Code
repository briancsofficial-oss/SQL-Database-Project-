-- 3. DATABASE QUERIES

-- Query 1:
-- Find all visitors with currently active memberships.

SELECT
    v.Visitor_ID,
    v.Name,
    m.Membership_ID,
    m.Membership_Start_Date,
    m.Membership_End_Date
FROM Visitor v
JOIN Membership m
    ON v.Visitor_ID = m.Visitor_ID
WHERE
    m.Membership_Start_Date <= CAST(GETDATE() AS DATE)
    AND (
        m.Membership_End_Date IS NULL
        OR m.Membership_End_Date >= CAST(GETDATE() AS DATE)
    )
ORDER BY v.Name;


-- Query 2:
-- Find books that currently have at least one available copy.

SELECT DISTINCT
    b.Title,
    b.ISBN
FROM Book b
JOIN Copy c
    ON b.ISBN = c.ISBN
WHERE c.Status = 'Available'
ORDER BY b.Title;



-- Query 3:
-- Count the number of unique visitors who have borrowed
-- books written by each author.

SELECT
    a.Author_ID,
    a.Name,
    COUNT(DISTINCT l.Visitor_ID) AS Distinct_Visitors
FROM Author a
JOIN Book_Author ba
    ON a.Author_ID = ba.Author_ID
JOIN Loan l
    ON ba.ISBN = l.ISBN
GROUP BY
    a.Author_ID,
    a.Name
ORDER BY Distinct_Visitors DESC;



-- Query 4:
-- Find authors whose books are available in two or more
-- languages.

SELECT
    a.Author_ID,
    a.Name,
    COUNT(DISTINCT bl.Language_ID) AS Language_Count
FROM Author a
JOIN Book_Author ba
    ON a.Author_ID = ba.Author_ID
JOIN BookLanguage bl
    ON ba.ISBN = bl.ISBN
GROUP BY
    a.Author_ID,
    a.Name
HAVING COUNT(DISTINCT bl.Language_ID) >= 2
ORDER BY Language_Count DESC;



-- Query 5:
-- Generate borrowing activity for each visitor.
--
-- Shows:
--   1. Number of loans during the last 30 days
--   2. Number of overdue loans
--
-- A loan is considered overdue when it remains unreturned
-- for more than 14 days or was returned after 14 days.

SELECT
    v.Visitor_ID,
    v.Name,

    SUM(
        CASE
            WHEN l.Loan_Date >= DATEADD(
                day,
                -30,
                CAST(GETDATE() AS DATE)
            )
            THEN 1
            ELSE 0
        END
    ) AS Loans_Last_30_Days,

    SUM(
        CASE
            WHEN (
                l.Return_Date IS NOT NULL
                AND l.Return_Date > DATEADD(day, 14, l.Loan_Date)
            )
            OR (
                l.Return_Date IS NULL
                AND CAST(GETDATE() AS DATE)
                    > DATEADD(day, 14, l.Loan_Date)
            )
            THEN 1
            ELSE 0
        END
    ) AS Overdue_Loans

FROM Visitor v
LEFT JOIN Loan l
    ON v.Visitor_ID = l.Visitor_ID
GROUP BY
    v.Visitor_ID,
    v.Name
ORDER BY v.Visitor_ID;
