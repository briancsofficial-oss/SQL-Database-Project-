/*
============================================================
 Magic Library Management Database
 Microsoft SQL Server

 Main Purpose:
 A relational database designed for the "Magical" library. Used
 to model the operations of  a public library, including books, authors,
physical copies, visitors, memberships, loans, sections, and languages.
============================================================
*/



-- 1. TABLE CREATION

CREATE TABLE Library (
    Library_ID INT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL,
    Location VARCHAR(100),
    Founded_Year INT
);


CREATE TABLE Section (
    Section_ID INT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL,
    Library_ID INT NOT NULL,

    FOREIGN KEY (Library_ID)
        REFERENCES Library(Library_ID)
);


CREATE TABLE Book (
    ISBN VARCHAR(20) PRIMARY KEY,
    Title VARCHAR(200) NOT NULL,
    Section_ID INT NOT NULL,

    FOREIGN KEY (Section_ID)
        REFERENCES Section(Section_ID)
);


CREATE TABLE Author (
    Author_ID INT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL
);


-- Many-to-many relationship between books and authors
CREATE TABLE Book_Author (
    ISBN VARCHAR(20) NOT NULL,
    Author_ID INT NOT NULL,

    PRIMARY KEY (ISBN, Author_ID),

    FOREIGN KEY (ISBN)
        REFERENCES Book(ISBN),

    FOREIGN KEY (Author_ID)
        REFERENCES Author(Author_ID)
);


-- Represents individual physical copies of each book
CREATE TABLE Copy (
    ISBN VARCHAR(20) NOT NULL,
    Copy_Number INT NOT NULL,
    Status VARCHAR(20) NOT NULL,

    PRIMARY KEY (ISBN, Copy_Number),

    FOREIGN KEY (ISBN)
        REFERENCES Book(ISBN),

    CONSTRAINT CHK_Copy_Status
        CHECK (Status IN ('Available', 'Checked Out', 'Lost', 'Maintenance'))
);


CREATE TABLE Visitor (
    Visitor_ID INT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL,
    Address VARCHAR(200),
    Phone VARCHAR(20)
);


-- Membership information is stored separately from visitors
CREATE TABLE Membership (
    Membership_ID VARCHAR(30) PRIMARY KEY,
    Visitor_ID INT NOT NULL,
    Membership_Start_Date DATE NOT NULL,
    Membership_End_Date DATE,

    FOREIGN KEY (Visitor_ID)
        REFERENCES Visitor(Visitor_ID),

    CONSTRAINT CHK_Membership_Dates
        CHECK (
            Membership_End_Date IS NULL
            OR Membership_End_Date >= Membership_Start_Date
        )
);


CREATE TABLE Loan (
    Loan_ID INT PRIMARY KEY,
    Loan_Date DATE NOT NULL,
    Return_Date DATE,
    Fine_Amount DECIMAL(8,2) DEFAULT 0.00,
    Visitor_ID INT NOT NULL,
    ISBN VARCHAR(20) NOT NULL,
    Copy_Number INT NOT NULL,

    FOREIGN KEY (Visitor_ID)
        REFERENCES Visitor(Visitor_ID),

    FOREIGN KEY (ISBN, Copy_Number)
        REFERENCES Copy(ISBN, Copy_Number),

    CONSTRAINT CHK_Fine_Amount
        CHECK (Fine_Amount >= 0),

    CONSTRAINT CHK_Loan_Dates
        CHECK (
            Return_Date IS NULL
            OR Return_Date >= Loan_Date
        )
);


CREATE TABLE [Language] (
    Language_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL
);


-- Many-to-many relationship between books and languages
CREATE TABLE BookLanguage (
    ISBN VARCHAR(20) NOT NULL,
    Language_ID INT NOT NULL,

    PRIMARY KEY (ISBN, Language_ID),

    FOREIGN KEY (ISBN)
        REFERENCES Book(ISBN),

    FOREIGN KEY (Language_ID)
        REFERENCES [Language](Language_ID)
);



