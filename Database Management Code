-- Question 1: 
SELECT
  Name,
  Membership_ID
FROM Visitor
WHERE Membership_ID IS NOT NULL
  AND Membership_Start_Date <= CAST(GETDATE() AS DATE)
  AND (Membership_End_Date IS NULL OR Membership_End_Date >= CAST(GETDATE() AS DATE))
ORDER BY Name;

-- Question 2: 
SELECT DISTINCT
  b.Title,
  b.ISBN
FROM Book b
JOIN Copy c
  ON b.ISBN = c.ISBN
WHERE c.Status = 'Available'
ORDER BY b.Title;

-- Question 3: 
SELECT
  a.Author_ID,
  a.Name,
  COUNT(DISTINCT l.Visitor_ID) AS Distinct_Visitors
FROM Author a
JOIN Book_Author ba
  ON a.Author_ID = ba.Author_ID
JOIN Loan l
  ON ba.ISBN = l.ISBN
GROUP BY a.Author_ID, a.Name
ORDER BY Distinct_Visitors DESC;

-- Question 4: 
SELECT
  a.Author_ID,
  a.Name,
  COUNT(DISTINCT bl.Language_ID) AS Language_Count
FROM Author a
JOIN Book_Author ba
  ON a.Author_ID = ba.Author_ID
JOIN BookLanguage bl
  ON ba.ISBN = bl.ISBN
GROUP BY a.Author_ID, a.Name
HAVING COUNT(DISTINCT bl.Language_ID) >= 2;


-- Question 5: 
SELECT
  v.Visitor_ID,
  v.Name,

  SUM(CASE
        WHEN l.Loan_Date >= DATEADD(day, -30, CAST(GETDATE() AS DATE))
        THEN 1 ELSE 0
      END) AS Loans_Last_30_Days,

  SUM(CASE
        WHEN (l.Return_Date IS NOT NULL AND l.Return_Date > DATEADD(day, 14, l.Loan_Date))
          OR (l.Return_Date IS NULL AND CAST(GETDATE() AS DATE) > DATEADD(day, 14, l.Loan_Date))
        THEN 1 ELSE 0
      END) AS Overdue_Loans

FROM Visitor v
LEFT JOIN Loan l
  ON v.Visitor_ID = l.Visitor_ID
GROUP BY v.Visitor_ID, v.Name
ORDER BY v.Visitor_ID;

